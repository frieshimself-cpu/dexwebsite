# MemeRocket server configuration
# Copy to .env (or set as real environment variables on your host).

# Port the API + website server listens on
PORT=8787

# Solana RPC endpoint. The free public one works but is rate-limited —
# for production grab a free key from helius.dev or quicknode.com.
RPC_URL=https://api.mainnet-beta.solana.com

# PUBLIC wallet address that receives boost/ad payments.
# NEVER put a private key here — receiving payments only needs the address.
RECEIVE_WALLET=9MD7xLYTTtSCXLpZYmDkQs5h3ZVLBgwLXay6HBZA9Ktf

# Secret key for the /api/admin/* endpoints (pick any long random string)
ADMIN_KEY=change-me-to-something-long-and-random

# Used if live SOL price feeds are unreachable
SOL_PRICE_FALLBACK=150
